# ===== 汀家 Agent 环境变量样例（复制为 .env 后填写真实值，.env 不入库）=====

# 运行环境：local(本地开发) / prod(VPS)
APP_ENV=local
LOG_LEVEL=INFO

# 汀宝宝 MongoDB（本地开发走 SSH 隧道；VPS 用只读账号直连）
# 本地: mongodb://127.0.0.1:27017/ting_baby   (隧道见 scripts/tunnel.sh，M2 提供)
# VPS : mongodb://readonly_user:密码@host.docker.internal:27017/ting_baby?authSource=admin
MONGO_URI=mongodb://127.0.0.1:27017/ting_baby

# 与汀宝宝共享的 JWT secret（校验前端传来的用户 JWT；真实值见汀宝宝 backend .env）
JWT_SECRET=change_me

# LLM（复用汀宝宝已有 DeepSeek key）
DEEPSEEK_API_KEY=change_me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 汀宝宝 Node 后端地址（写工具经此调用，JWT 透传）
# 本地开发可用隧道指向 VPS；VPS 上为容器网络内地址
NODE_API_BASE_URL=http://127.0.0.1:3000

# 多模态图片理解（Qwen-VL 走 dashscope）
VISION_PROVIDER=qwen
DASHSCOPE_API_KEY=change_me

# Agent 护栏
AGENT_MAX_ITERS=6

# 前端直连 Agent 服务为跨源请求；"*" 放行全部（仅 local），prod 配具体域名逗号分隔
CORS_ORIGINS=*